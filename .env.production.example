# Backline PRODUCTION configuration reference (18-Storage-Deployment.md §18.5).
#
# There are two templates in this repo, on purpose:
#   .env.example             -> LOCAL DEVELOPMENT (localhost Mongo/Redis/MinIO defaults)
#   .env.production.example  -> THIS FILE: what to set on Railway/Vercel for real users
#
# NAMES AND SHAPES ONLY - never put real secrets in here, and never commit a real .env
# (both `.env` and `.env.*.local` are gitignored; only these .example files are committed).
#
# Step-by-step instructions for where each value comes from: see DEPLOYMENT.md.

# =====================================================================================
# REQUIRED IN PRODUCTION
# =====================================================================================

# Turns off dev-only behaviour. Use exactly: production
ENVIRONMENT=production

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Must include the password. MONGO_DB_NAME below selects the application database, so
# the URI may use Atlas's default `/` path before `?retryWrites=true&w=majority`.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=backline_prod

# Redis (Railway's Redis plugin exposes this as REDIS_URL automatically).
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Cloudflare R2 (S3-compatible object storage) for screenshots, snapshots, attachments.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=backline-prod
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto

# Signs login tokens. MUST be changed from the dev default - anyone who knows it can
# mint a valid session for any account. Generate with:  openssl rand -hex 32
JWT_SIGNING_KEY=

# Encrypts third-party OAuth tokens before they're stored in Mongo. MUST be changed -
# the default in app/core/config.py is a publicly-known value committed to this repo.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_ENCRYPTION_KEY=

# Which browser origins may call this API. Anything not listed here is blocked.
#
# !! MUST be a JSON array. A comma-separated list CRASHES THE APP AT STARTUP. !!
#   correct:   ["https://app.yourdomain.com"]
#   wrong:     https://app.yourdomain.com,https://yourdomain.com
CORS_ALLOW_ORIGINS=["https://app.yourdomain.com"]

# Public HTTPS URL of THIS backend. Used to build the <script src> for the review widget
# that gets injected into every proxied client page - if this is wrong, the widget never
# loads on your customers' sites.
PUBLIC_API_BASE_URL=https://api.yourdomain.com

# Public HTTPS URL of the dashboard frontend. Used for deep links back into the app
# (e.g. from a ClickUp task to the comment it came from).
PUBLIC_DASHBOARD_BASE_URL=https://app.yourdomain.com

# =====================================================================================
# OPTIONAL - each is a no-op while blank, so you can launch without them and add later
# =====================================================================================

# Transactional email (login codes, notification digests). WITHOUT THIS, EMAIL SIGN-IN
# CODES ARE ONLY WRITTEN TO THE SERVER LOG - fine for a private pilot, not for real
# customers signing themselves up. Get a key at resend.com, and verify your domain.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Backline <onboarding@yourdomain.com>

# "Sign in with Google". Redirect URI must be registered in Google Cloud Console and
# match exactly, including https and no trailing slash.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.yourdomain.com/auth/callback

# ClickUp integration (turn comments into ClickUp tasks).
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=
CLICKUP_OAUTH_REDIRECT_URI=https://app.yourdomain.com/integrations/clickup/callback

# Jira integration (turn comments into Jira issues). Register a 3LO OAuth app at
# developer.atlassian.com/console/myapps with the `read:jira-work write:jira-work
# offline_access` scopes and this redirect URI.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=https://app.yourdomain.com/integrations/jira/callback

# Asana integration (turn comments into Asana tasks). Register an OAuth app at
# app.asana.com/0/developer-console with this redirect URI.
ASANA_OAUTH_CLIENT_ID=
ASANA_OAUTH_CLIENT_SECRET=
ASANA_OAUTH_REDIRECT_URI=https://app.yourdomain.com/integrations/asana/callback

# Error tracking. Blank = disabled. Strongly recommended before real customers.
SENTRY_DSN=

# AI replies (docs/tdr/0033, docs/tdr/0034). Powers the "Summarize" and "Write a reply
# for me" / "Suggest replies" actions on a comment thread. Blank ([]) = disabled - those
# actions fall back to a labeled placeholder instead of failing. Get a free key at
# https://console.groq.com/keys (Part 8.7 of DEPLOYMENT.md).
#
# MUST be a JSON array, same rule as CORS_ALLOW_ORIGINS above - e.g. ["gsk_..."] for one
# key, ["gsk_...","gsk_...","gsk_..."] for rotation. Groq limits are organization-wide,
# so additional keys do not increase quota and must not be used to evade those limits.
GROQ_API_KEYS=[]
GROQ_MODEL=openai/gpt-oss-120b

# =====================================================================================
# DASHBOARD (set these in VERCEL, not Railway)
#
# These are baked into the JavaScript bundle at BUILD time, not read at run time - so
# after changing any of them you must REDEPLOY on Vercel for the change to take effect.
# They ship inside the browser bundle, so only ever put non-secret values here (a Google
# *client ID* and a Sentry DSN are designed to be public; a client *secret* is not).
# =====================================================================================
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_GOOGLE_OAUTH_CLIENT_ID=
# VITE_CLICKUP_OAUTH_CLIENT_ID=
# VITE_JIRA_OAUTH_CLIENT_ID=
# VITE_ASANA_OAUTH_CLIENT_ID=
# VITE_SENTRY_DSN=

# =====================================================================================
# TUNING - safe defaults in app/core/config.py; override only if you have a reason
# =====================================================================================
# JWT_ACCESS_TTL_MINUTES=15
# JWT_REFRESH_TTL_DAYS=30
# GUEST_TOKEN_TTL_DAYS=30
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# Per-minute rate limits (per IP / per actor):
# OTP_REQUEST_RATE_LIMIT_PER_MINUTE=5
# REVIEW_RESOLVE_RATE_LIMIT_PER_MINUTE=30
# GUEST_SESSION_RATE_LIMIT_PER_MINUTE=10
# PROXY_RATE_LIMIT_PER_MINUTE=1200  (per share link + IP)
# PAGE_REGISTER_RATE_LIMIT_PER_MINUTE=30
# SNAPSHOT_SUBMIT_RATE_LIMIT_PER_MINUTE=30
# COMMENT_CREATE_RATE_LIMIT_PER_MINUTE=20
# UPLOAD_RATE_LIMIT_PER_MINUTE=20
