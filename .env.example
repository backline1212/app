# Copy to .env for local dev. Never commit the real .env file.

ENVIRONMENT=local

# Backend
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=backline_local
REDIS_URL=redis://localhost:6379

# R2 (MinIO locally - see infra/local/start-minio.sh)
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=backline-local
R2_SECRET_ACCESS_KEY=backline-local-secret
R2_BUCKET_NAME=backline-local
R2_ENDPOINT_URL=http://localhost:9000

# Auth
JWT_SIGNING_KEY=dev-only-change-me
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Email
RESEND_API_KEY=

# Integrations (Milestone 10). Trello has no app-level key here by design - the agency
# pastes their own personal API key + token (generated from Trello's own token page),
# mirroring Slack's "simplest possible connection" precedent rather than registering a
# Backline Power-Up app (docs/tdr/0009).
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=
CLICKUP_OAUTH_REDIRECT_URI=http://localhost:5173/integrations/clickup/callback
# Jira integration (turn comments into Jira issues). Register a 3LO OAuth app at
# developer.atlassian.com/console/myapps with the `read:jira-work write:jira-work
# offline_access` scopes and this redirect URI.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:5173/integrations/jira/callback
# Asana integration (turn comments into Asana tasks). Register an OAuth app at
# app.asana.com/0/developer-console with this redirect URI.
ASANA_OAUTH_CLIENT_ID=
ASANA_OAUTH_CLIENT_SECRET=
ASANA_OAUTH_REDIRECT_URI=http://localhost:5173/integrations/asana/callback
# Fernet key (Fernet.generate_key()) for encrypting OAuth tokens at rest - never reuse
# the local dev default in a real deployment.
INTEGRATIONS_ENCRYPTION_KEY=

# Error tracking (Milestone 12, docs/tdr/0011). Empty = disabled; no real Sentry
# project exists for this build, same as every other credential-gated integration here.
SENTRY_DSN=

# Frontend (Vite - must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# Must be the same Google OAuth client as GOOGLE_OAUTH_CLIENT_ID above (client IDs are
# not secret, so it's safe client-side; GOOGLE_OAUTH_CLIENT_SECRET never is).
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Same as CLICKUP_OAUTH_CLIENT_ID above - not secret, safe client-side.
VITE_CLICKUP_OAUTH_CLIENT_ID=
# Same as JIRA_OAUTH_CLIENT_ID / ASANA_OAUTH_CLIENT_ID above - not secret, safe client-side.
VITE_JIRA_OAUTH_CLIENT_ID=
VITE_ASANA_OAUTH_CLIENT_ID=
# Sentry DSNs are not secret (they're embedded in shipped client bundles by design).
VITE_SENTRY_DSN=
