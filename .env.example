# Copy to .env for local dev. Never commit the real .env file.

ENVIRONMENT=local

# Backend
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=backline_local
REDIS_URL=redis://localhost:6379

# R2 (MinIO locally - see infra/local/start-minio.sh)
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=backline-local
R2_SECRET_ACCESS_KEY=backline-local-secret
R2_BUCKET_NAME=backline-local
R2_ENDPOINT_URL=http://localhost:9000

# Auth
JWT_SIGNING_KEY=dev-only-change-me
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Email
RESEND_API_KEY=

# Integrations (Milestone 10, docs/tdr/0046). All optional: every integration connects
# from the Integrations page with a token or webhook URL the admin pastes. Setting a
# provider's OAuth client id AND secret below only adds a "Continue with ..." button.
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=
CLICKUP_OAUTH_REDIRECT_URI=http://localhost:5173/integrations/clickup/callback
# Jira integration (turn comments into Jira issues). Register a 3LO OAuth app at
# developer.atlassian.com/console/myapps with the `read:jira-work write:jira-work
# offline_access` scopes and this redirect URI.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:5173/integrations/jira/callback
# Asana integration (turn comments into Asana tasks). Register an OAuth app at
# app.asana.com/0/developer-console with this redirect URI.
ASANA_OAUTH_CLIENT_ID=
ASANA_OAUTH_CLIENT_SECRET=
ASANA_OAUTH_REDIRECT_URI=http://localhost:5173/integrations/asana/callback
# Fernet key (Fernet.generate_key()) for encrypting OAuth tokens at rest - never reuse
# the local dev default in a real deployment.
INTEGRATIONS_ENCRYPTION_KEY=

# Error tracking (Milestone 12, docs/tdr/0011). Empty = disabled; no real Sentry
# project exists for this build, same as every other credential-gated integration here.
SENTRY_DSN=

# Billing (docs/tdr/0051). Stripe: international cards and wallets. Razorpay: UPI
# (QR or UPI ID), RuPay/Indian cards and netbanking, in INR. A gateway is live as soon
# as its keys are set. Webhooks: /api/v1/billing/webhooks/stripe and .../razorpay.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# While a gateway has no keys, its checkout completes as a labelled test payment that
# activates the plan without charging. Never allowed when ENVIRONMENT=production.
BILLING_SANDBOX_ENABLED=true

# AI (docs/tdr/0033, docs/tdr/0034): powers the "Summarize" and "Write a reply for me"
# / "Suggest replies" actions on a comment thread (backend/app/modules/ai). Empty =
# disabled - those actions fall back to a labeled placeholder instead of failing.
# Must be a JSON array, same rule as CORS_ALLOW_ORIGINS below - a bare comma-separated
# list crashes the app at startup. Get a free key at https://console.groq.com/keys.
#   one key:      ["gsk_..."]
#   several:      ["gsk_...", "gsk_...", "gsk_..."]
# Multiple keys support rotation and revocation, but do not increase quota: Groq's
# limits are organization-wide. Do not create or orchestrate extra accounts to bypass
# them. The pool (ai/key_pool.py) returns a graceful "busy, try again" response while
# the organization is cooling down after a rate-limit response.
GROQ_API_KEYS=[]
GROQ_MODEL=openai/gpt-oss-120b

# Frontend (Vite - must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# Must be the same Google OAuth client as GOOGLE_OAUTH_CLIENT_ID above (client IDs are
# not secret, so it's safe client-side; GOOGLE_OAUTH_CLIENT_SECRET never is).
VITE_GOOGLE_OAUTH_CLIENT_ID=
# VITE_CLICKUP/JIRA/ASANA_OAUTH_CLIENT_ID are no longer read (docs/tdr/0046): the API
# builds the OAuth authorize URLs from the *_OAUTH_* settings above.
# Sentry DSNs are not secret (they're embedded in shipped client bundles by design).
VITE_SENTRY_DSN=
