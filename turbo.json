{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VERCEL_GIT_COMMIT_SHA",
        "VITE_API_BASE_URL",
        "VITE_SENTRY_DSN",
        "BACKLINE_API_BASE_URL",
        "BACKLINE_DASHBOARD_BASE_URL"
      ],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
